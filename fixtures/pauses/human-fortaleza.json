  "segments": [
    {"idx":0,"start":1.76,"end":6.790931989924433,"text":"Olha, a gente se mudou pra Fortaleza em 78.","confidence":0.917,"words":[[1.76,2.46,"Olha,",0.984],[2.46,2.58,"a",0.999],[2.58,3.18,"gente",1],[3.18,3.43,"se",1],[3.43,4.03,"mudou",0.998],[4.03,4.4,"pra",0.811],[4.4,5.48,"Fortaleza",0.994],[5.48,5.53,"em",0.961],[5.78,6.79,"78.",0.51]]},
    {"idx":1,"start":6.894307304785895,"end":15.44,"text":"O José arrumou um emprego no porto do Mucuripe e a gente veio de ônibus com três meninos pequenos e duas malas.","confidence":0.957,"words":[[6.89,6.97,"O",0.648],[6.97,7.33,"José",0.975],[7.33,7.99,"arrumou",0.999],[7.99,8.13,"um",0.842],[8.19,8.81,"emprego",1],[8.81,8.87,"no",0.997],[9,9.46,"porto",0.998],[9.46,9.48,"do",1],[9.82,10.36,"Mucuripe",0.998],[10.37,10.47,"e",0.887],[10.47,10.56,"a",1],[10.56,11.02,"gente",1],[11.02,11.39,"veio",0.997],[11.39,11.57,"de",1],[11.57,12.12,"ônibus",1],[12.12,12.4,"com",0.959],[12.4,12.61,"três",0.839],[12.61,13.35,"meninos",0.928],[13.45,14.05,"pequenos",0.994],[14.14,14.21,"e",0.999],[14.34,14.6,"duas",1],[14.6,15.44,"malas.",1]]},
    {"idx":2,"start":15.44,"end":18.115,"text":"Eu nunca tinha visto o mar, imagine.","confidence":0.895,"words":[[15.44,15.58,"Eu",0.999],[15.58,15.84,"nunca",1],[16.08,16.39,"tinha",1],[16.39,16.8,"visto",1],[16.8,16.88,"o",0.484],[16.88,17.29,"mar,",0.982],[17.29,18.11,"imagine.",0.797]]},
    {"idx":3,"start":18.115,"end":21.313369565217393,"text":"Trinta anos de idade e nunca tinha visto o mar.","confidence":0.984,"words":[[18.11,18.46,"Trinta",0.84],[18.88,18.93,"anos",1],[18.93,18.99,"de",1],[19.13,19.5,"idade",1],[19.51,19.58,"e",1],[19.58,19.99,"nunca",1],[19.99,20.36,"tinha",0.999],[20.43,20.8,"visto",1],[20.8,20.88,"o",1],[20.88,21.31,"mar.",1]]},
    {"idx":4,"start":21.604130434782608,"end":28.28,"text":"Quando o ônibus chegou perto da beira-mar, eu vi aquela água sem fim, comecei a chorar.","confidence":0.975,"words":[[21.6,22.03,"Quando",0.979],[22.03,22.12,"o",1],[22.12,22.63,"ônibus",1],[22.63,23.15,"chegou",1],[23.15,23.26,"perto",1],[23.66,23.77,"da",0.998],[23.77,24.71,"beira-mar,",0.86],[24.71,24.84,"eu",1],[24.94,25.06,"vi",0.945],[25.06,25.58,"aquela",1],[25.58,25.93,"água",1],[25.93,26.2,"sem",0.985],[26.2,26.63,"fim,",0.834],[26.63,27.24,"comecei",0.999],[27.28,27.3,"a",1],[27.33,28.28,"chorar.",1]]},
    {"idx":5,"start":29.49,"end":34.50953619909502,"text":"O Marcos, o mais velho, perguntou se eu tava triste, eu disse que não, que era o contrário.","confidence":0.97,"words":[[29.49,29.53,"O",0.975],[29.53,29.93,"Marcos,",0.996],[30.08,30.08,"o",1],[30.14,30.33,"mais",1],[30.33,30.66,"velho,",0.999],[30.76,31.31,"perguntou",1],[31.32,31.42,"se",1],[31.53,31.55,"eu",0.999],[31.55,31.8,"tava",0.841],[31.8,32.25,"triste,",0.71],[32.34,32.42,"eu",0.993],[32.42,32.58,"disse",1],[32.92,32.92,"que",1],[33.01,33.11,"não,",0.952],[33.25,33.41,"que",1],[33.61,33.61,"era",1],[33.64,33.67,"o",1],[33.67,34.51,"contrário.",1]]},
    {"idx":6,"start":34.58073529411765,"end":39.98,"text":"A primeira casa foi na Praia de Iracema, numa rua estreitinha, estreitinha.","confidence":0.929,"words":[[34.58,34.62,"A",0.528],[34.62,35.23,"primeira",1],[35.23,35.53,"casa",1],[35.77,35.79,"foi",0.999],[35.79,35.95,"na",1],[35.95,36.33,"Praia",0.858],[36.35,36.49,"de",0.964],[36.49,37.19,"Iracema,",0.884],[37.19,37.4,"numa",0.998],[37.74,37.74,"rua",1],[37.89,38.64,"estreitinha,",0.92],[38.78,39.98,"estreitinha.",0.998]]},
    {"idx":7,"start":41.12,"end":50.12,"text":"Era alugada, tinha goteira na cozinha, mas de noite, quando a casa ficava em silêncio, dava pra ouvir as ondas batendo.","confidence":0.995,"words":[[41.12,41.12,"Era",0.999],[41.14,41.75,"alugada,",1],[41.76,42.21,"tinha",0.995],[42.33,42.83,"goteira",0.961],[42.83,42.94,"na",1],[43.05,43.73,"cozinha,",1],[43.81,44.02,"mas",0.999],[44.25,44.25,"de",0.998],[44.45,44.83,"noite,",0.951],[45.03,45.41,"quando",1],[45.41,45.5,"a",1],[45.5,45.84,"casa",1],[45.91,46.39,"ficava",1],[46.39,46.56,"em",1],[46.56,47.45,"silêncio,",1],[47.45,47.81,"dava",1],[47.81,48.02,"pra",1],[48.14,48.52,"ouvir",1],[48.52,48.61,"as",1],[48.71,49.14,"ondas",0.999],[49.14,50.12,"batendo.",0.983]]},
    {"idx":8,"start":50.12,"end":54.643497005988024,"text":"E eu dormia com aquele barulho e sonhava com um sertão.","confidence":0.955,"words":[[50.12,50.18,"E",0.991],[50.18,50.38,"eu",1],[50.38,50.97,"dormia",1],[50.97,51.24,"com",1],[51.27,51.88,"aquele",1],[51.88,52.57,"barulho",1],[52.57,52.67,"e",1],[52.67,53.31,"sonhava",1],[53.36,53.36,"com",1],[53.77,53.85,"um",0.597],[53.85,54.64,"sertão.",0.921]]},
    {"idx":9,"start":54.75473053892216,"end":56.38615568862276,"text":"Engraçado, né?","confidence":0.998,"words":[[54.75,55.83,"Engraçado,",0.996],[55.83,56.39,"né?",0.999]]},
    {"idx":10,"start":56.64570059880239,"end":60.44,"text":"Morando do lado do mar e sonhando com a seca.","confidence":0.996,"words":[[56.65,57.18,"Morando",0.981],[57.18,57.37,"do",0.984],[57.37,57.76,"lado",1],[57.89,57.98,"do",1],[57.98,58.28,"mar",1],[58.28,58.39,"e",1],[58.39,59.22,"sonhando",0.999],[59.22,59.53,"com",1],[59.53,59.62,"a",1],[59.62,60.44,"seca.",1]]},
    {"idx":11,"start":62.28,"end":65.82,"text":"Então, pra ajudar em casa, eu comecei a costurar pra fora, né?","confidence":0.997,"words":[[62.28,62.62,"Então,",0.968],[62.83,62.87,"pra",0.999],[62.87,63.25,"ajudar",1],[63.27,63.37,"em",1],[63.37,63.74,"casa,",1],[63.74,63.86,"eu",1],[63.86,64.29,"comecei",1],[64.29,64.35,"a",1],[64.35,64.84,"costurar",0.999],[64.84,64.89,"pra",1],[65.26,65.35,"fora,",0.998],[65.47,65.82,"né?",0.996]]},
    {"idx":12,"start":66.16,"end":71.41,"text":"Comprei uma máquina Singer de segunda mão, pagando um pouquinho por mês.","confidence":0.952,"words":[[66.16,66.37,"Comprei",0.997],[66.37,66.57,"uma",1],[66.8,67.25,"máquina",1],[67.25,67.77,"Singer",0.433],[67.77,67.94,"de",0.998],[67.94,68.55,"segunda",1],[68.55,68.98,"mão,",0.997],[68.98,69.59,"pagando",1],[69.59,69.63,"um",1],[69.77,70.54,"pouquinho",1],[70.54,70.75,"por",1],[70.86,71.41,"mês.",0.997]]},
    {"idx":13,"start":72.3,"end":76.5,"text":"Fazia vestido de noiva, farda de colégio, roupa de quadrilha.","confidence":0.999,"words":[[72.3,72.3,"Fazia",0.999],[72.32,72.66,"vestido",1],[72.87,72.97,"de",1],[72.97,73.54,"noiva,",1],[73.54,73.94,"farda",0.998],[73.95,74.11,"de",1],[74.11,74.84,"colégio,",0.999],[74.84,75.25,"roupa",0.999],[75.3,75.39,"de",1],[75.49,76.5,"quadrilha.",0.999]]},
    {"idx":14,"start":77.43,"end":81.59,"text":"Teve um ano que eu costurei 40 fardas pro Colégio das Freiras.","confidence":0.974,"words":[[77.43,77.43,"Teve",1],[77.45,77.46,"um",0.978],[77.46,77.69,"ano",1],[77.7,77.8,"que",1],[78.01,78.09,"eu",1],[78.09,78.71,"costurei",1],[78.71,79.11,"40",0.821],[79.21,79.65,"fardas",0.999],[79.65,79.84,"pro",0.998],[79.9,80.43,"Colégio",0.898],[80.5,80.58,"das",0.995],[80.7,81.59,"Freiras.",0.999]]},
    {"idx":15,"start":82.11,"end":87.07,"text":"Os meninos dormiam e eu ficava pedalando aquela máquina até de madrugada.","confidence":0.993,"words":[[82.11,82.11,"Os",1],[82.11,82.35,"meninos",1],[82.35,82.94,"dormiam",1],[82.94,83.02,"e",0.999],[83.02,83.12,"eu",1],[83.2,83.69,"ficava",1],[83.69,84.45,"pedalando",0.957],[84.45,84.72,"aquela",0.956],[85.11,85.45,"máquina",1],[85.63,85.8,"até",1],[85.8,85.97,"de",1],[85.97,87.07,"madrugada.",1]]},
    {"idx":16,"start":88.07,"end":92.81,"text":"Foi com essa máquina que a gente comprou a casa própria, lá no Montese.","confidence":0.992,"words":[[88.07,88.07,"Foi",0.962],[88.1,88.13,"com",1],[88.13,88.46,"essa",1],[88.68,89.06,"máquina",1],[89.06,89.31,"que",1],[89.31,89.4,"a",1],[89.4,89.82,"gente",1],[89.82,90.4,"comprou",1],[90.4,90.48,"a",1],[90.48,90.81,"casa",1],[90.81,91.57,"própria,",0.986],[91.57,91.67,"lá",1],[91.86,91.89,"no",1],[91.89,92.81,"Montese.",0.942]]},
    {"idx":17,"start":92.81,"end":97.88,"text":"E é isso, Fortaleza me deu uma e me deu uma casa.","confidence":0.931,"words":[[92.81,93,"E",0.81],[93,93.21,"é",0.999],[93.21,94.33,"isso,",0.884],[94.47,95.24,"Fortaleza",0.996],[95.24,95.34,"me",0.996],[95.48,95.65,"deu",0.999],[95.77,96.1,"uma",0.924],[96.1,96.22,"e",0.627],[96.22,96.42,"me",0.999],[96.52,96.83,"deu",0.999],[96.89,96.89,"uma",1],[97.43,97.88,"casa.",0.938]]}
