    {"idx":6,"start":26.31,"end":30.58,"text":"Eu só descobri muitos anos depois, pelo cheiro.","confidence":0.997,"words":[[26.31,26.521632653061225,"Eu",0.991],[26.521632653061225,26.733265306122448,"só",0.997],[26.733265306122448,27.57979591836735,"descobri",0.998],[27.57979591836735,28.14,"muitos",0.993],[28.301836734693875,28.625510204081635,"anos",1],[28.725102040816328,29.484489795918368,"depois,",0.999],[29.484489795918368,29.89530612244898,"pelo",1],[29.945102040816327,30.58,"cheiro.",1]]},
