    {"idx":0,"start":0,"end":3.6,"text":"Quando eu era pequeno, a gente morava em Itaberaba, numa casa de esquina.","confidence":0.994,"words":[[0,0.311731843575419,"Quando",0.985],[0.311731843575419,0.39217877094972065,"eu",1],[0.45251396648044695,0.5731843575418994,"era",1],[0.593296089385475,1.075977653631285,"pequeno,",0.999],[1.075977653631285,1.1162011173184359,"a",0.995],[1.1262569832402234,1.3977653631284919,"gente",1],[1.3977653631284919,1.7195530726256985,"morava",0.999],[1.7195530726256985,1.8301675977653633,"em",0.996],[1.8301675977653633,2.403351955307263,"Itaberaba,",0.954],[2.5541899441340785,2.654748603351955,"numa",0.99],[2.654748603351955,2.8759776536312853,"casa",1],[2.8759776536312853,2.98659217877095,"de",1],[2.98659217877095,3.6,"esquina.",1]]},
    {"idx":1,"start":4.09,"end":8.03,"text":"Todo dia eu ia para a escola de bicicleta, uma bicicleta azul que era do meu irmão.","confidence":0.961,"words":[[4.09,4.09,"Todo",1],[4.11,4.18,"dia",1],[4.18,4.32,"eu",0.999],[4.32,4.44,"ia",1],[4.46,4.74,"para",0.407],[4.74,4.81,"a",0.999],[4.81,5.22,"escola",1],[5.23,5.37,"de",1],[5.37,6.15,"bicicleta,",1],[6.15,6.31,"uma",0.974],[6.31,6.78,"bicicleta",1],[6.78,6.99,"azul",0.999],[6.99,7.14,"que",0.997],[7.2,7.31,"era",1],[7.31,7.32,"do",0.959],[7.43,7.57,"meu",1],[7.57,8.03,"irmão.",1]]},
    {"idx":2,"start":8.45,"end":11.57,"text":"A professora se chamava Dona Celeste e usava uns óculos enormes.","confidence":0.999,"words":[[8.45,8.45,"A",1],[8.470459016393443,8.76711475409836,"professora",1],[8.76711475409836,8.869409836065573,"se",1],[8.930786885245901,9.319508196721312,"chamava",1],[9.319508196721312,9.565016393442624,"Dona",0.994],[9.565016393442624,9.994655737704917,"Celeste",0.999],[9.994655737704917,10.056032786885245,"e",1],[10.056032786885245,10.362918032786885,"usava",0.998],[10.362918032786885,10.54704918032787,"uns",0.995],[10.54704918032787,10.915311475409835,"óculos",1],[11.068754098360657,11.57,"enormes.",0.999]]},
    {"idx":3,"start":12.04,"end":14.78,"text":"Ela mandava a gente ler em voz alta, um de cada vez.","confidence":0.999,"words":[[12.04,12.04,"Ela",1],[12.06,12.36,"mandava",1],[12.36,12.43,"a",1],[12.43,12.78,"gente",1],[12.78,12.9,"ler",0.996],[13.06,13.13,"em",1],[13.13,13.34,"voz",1],[13.34,13.75,"alta,",0.996],[13.76,13.9,"um",0.998],[13.9,14.04,"de",1],[14.04,14.29,"cada",1],[14.33,14.78,"vez.",1]]},
    {"idx":4,"start":15.24,"end":17,"text":"Eu morria de vergonha, mas lia.","confidence":0.996,"words":[[15.24,15.24,"Eu",1],[15.24,15.42,"morria",0.991],[15.42,15.56,"de",1],[15.56,16.28,"vergonha,",1],[16.28,16.5,"mas",1],[16.5,17,"lia.",0.986]]},
    {"idx":5,"start":17.47,"end":20.25,"text":"No recreio a gente jogava bola de gude no patio de terra.","confidence":0.952,"words":[[17.47,17.47,"No",1],[17.490218181818182,17.67218181818182,"recreio",0.992],[17.67218181818182,17.732836363636366,"a",0.992],[17.732836363636366,17.985563636363636,"gente",1],[18.056327272727273,18.339381818181817,"jogava",1],[18.501127272727274,18.70330909090909,"bola",1],[18.70330909090909,18.83472727272727,"de",1],[18.83472727272727,19.087454545454545,"gude",0.834],[19.087454545454545,19.218872727272725,"no",0.998],[19.218872727272725,19.542363636363635,"patio",0.603],[19.542363636363635,19.67378181818182,"de",1],[19.67378181818182,20.25,"terra.",1]]},
    {"idx":6,"start":21.37,"end":23.87,"text":"Com 18 anos eu fui trabalhar numa gráfica em Salvador.","confidence":0.978,"words":[[21.37,21.37,"Com",1],[21.390746887966806,21.463360995850625,"18",0.787],[21.463360995850625,21.69157676348548,"anos",1],[21.69157676348548,21.795311203319503,"eu",0.997],[21.857551867219918,21.982033195020747,"fui",1],[21.982033195020747,22.511078838174274,"trabalhar",1],[22.511078838174274,22.718547717842323,"numa",1],[22.770414937759334,23.112738589211617,"gráfica",0.997],[23.143858921161826,23.25796680497925,"em",1],[23.25796680497925,23.87,"Salvador.",1]]},
    {"idx":7,"start":23.87,"end":27.54,"text":"O dono era um senhor alemão, muito sério, chamado Seu Otto.","confidence":0.982,"words":[[23.87,23.91123595505618,"O",0.999],[23.91123595505618,24.17926966292135,"dono",0.989],[24.17926966292135,24.3751404494382,"era",1],[24.447303370786518,24.519466292134833,"um",1],[24.519466292134833,24.93182584269663,"senhor",0.998],[24.93182584269663,25.46789325842697,"alemão,",1],[25.46789325842697,25.80808988764045,"muito",1],[25.80808988764045,26.28230337078652,"sério,",1],[26.28230337078652,26.68435393258427,"chamado",1],[26.766825842696626,26.962696629213482,"Seu",0.832],[26.962696629213482,27.54,"Otto.",0.981]]},
    {"idx":8,"start":28.04,"end":31.26,"text":"Eu comecei limpando as máquinas e depois aprendi a montar as letras.","confidence":0.951,"words":[[28.04,28.04,"Eu",0.407],[28.04,28.17,"comecei",1],[28.2,28.68,"limpando",1],[28.68,28.8,"as",1],[28.8,29.28,"máquinas",1],[29.28,29.34,"e",1],[29.34,29.7,"depois",1],[29.7,30.12,"aprendi",1],[30.12,30.18,"a",1],[30.18,30.45,"montar",1],[30.6,30.66,"as",1],[30.66,31.26,"letras.",0.999]]},
    {"idx":9,"start":31.74,"end":36.2,"text":"A gente imprimia convite de casamento, santinho de lição, cardápio de restaurante.","confidence":0.964,"words":[[31.74,31.74,"A",1],[31.74,31.74,"gente",1],[31.76,32.15,"imprimia",1],[32.21,32.6,"convite",1],[32.76,32.78,"de",1],[32.78,33.47,"casamento,",1],[33.47,33.98,"santinho",0.743],[33.98,34.11,"de",1],[34.11,34.49,"lição,",0.82],[34.57,34.97,"cardápio",0.999],[35.08,35.18,"de",1],[35.18,36.2,"restaurante.",1]]},
    {"idx":10,"start":36.71,"end":39.27,"text":"Eu ganhava pouco, mas mandava metade para minha mãe.","confidence":0.95,"words":[[36.71,36.71,"Eu",1],[36.71,36.84809128630705,"ganhava",1],[36.879958506224064,37.336721991701246,"pouco,",1],[37.336721991701246,37.52792531120332,"mas",1],[37.52792531120332,37.9846887966805,"mandava",1],[37.9846887966805,38.34585062240664,"metade",1],[38.36709543568465,38.632655601659756,"para",0.575],[38.632655601659756,38.94070539419087,"minha",0.976],[38.96195020746888,39.27,"mãe.",1]]},
