  "segments": [
    {"idx":0,"start":0.07,"end":4.01,"text":"O meu pai tinha um sítio pequeno perto de Garanhuns.","confidence":0.983,"words":[[0.07,0.16,"O",0.943],[0.16,0.33,"meu",1],[0.48,0.67,"pai",1],[0.74,1.18,"tinha",1],[1.18,1.22,"um",0.998],[1.43,1.81,"sítio",0.992],[1.81,2.42,"pequeno",0.998],[2.56,2.92,"perto",0.995],[2.92,3.1,"de",1],[3.1,4.01,"Garanhuns.",0.905]]},
    {"idx":1,"start":7.1,"end":11.26,"text":"Tinha seis vacas e um cavalo velho chamado Trovão.","confidence":0.993,"words":[[7.1,7.237959183673469,"Tinha",1],[7.237959183673469,7.673061224489795,"seis",0.976],[7.673061224489795,8.203673469387756,"vacas",1],[8.203673469387756,8.309795918367346,"e",1],[8.309795918367346,8.320408163265308,"um",1],[8.543265306122448,9.158775510204082,"cavalo",1],[9.286122448979592,9.593877551020409,"velho",1],[9.742448979591838,10.453469387755101,"chamado",1],[10.453469387755101,11.26,"Trovão.",0.965]]},
    {"idx":2,"start":14.77,"end":18.11,"text":"Eu acordava antes do sol para tirar o leite.","confidence":0.958,"words":[[14.77,14.77,"Eu",1],[14.77,15.35,"acordava",1],[15.35,15.83,"antes",1],[15.83,15.92,"do",1],[16.13,16.31,"sol",0.992],[16.31,16.7,"para",0.629],[16.7,17.12,"tirar",0.999],[17.26,17.27,"o",0.998],[17.27,18.11,"leite.",1]]},
    {"idx":3,"start":21.33,"end":25.09,"text":"A minha mãe fervia o leite num tacho de cobre.","confidence":0.985,"words":[[21.33,21.33,"A",1],[21.33,21.49,"minha",1],[21.49,21.81,"mãe",0.999],[21.81,22.44,"fervia",1],[22.44,22.48,"o",1],[22.69,23.07,"leite",1],[23.07,23.26,"num",0.849],[23.39,23.92,"tacho",0.997],[23.92,23.99,"de",1],[24.13,25.09,"cobre.",1]]},
    {"idx":4,"start":28.97,"end":33.17,"text":"Depois a gente vendia o queijo na feira de sábado.","confidence":1,"words":[[28.97,29.162857142857142,"Depois",1],[29.162857142857142,29.248571428571427,"a",0.999],[29.409285714285712,29.84857142857143,"gente",1],[29.84857142857143,30.534285714285712,"vendia",1],[30.534285714285712,30.555714285714288,"o",1],[30.630714285714287,31.327142857142857,"queijo",1],[31.327142857142857,31.48785714285714,"na",1],[31.63785714285714,32.05571428571429,"feira",0.999],[32.16285714285714,32.32357142857143,"de",1],[32.345,33.17,"sábado.",1]]},
    {"idx":5,"start":33.17,"end":39.65,"text":"Era um queijo coalho que todo mundo queria.","confidence":0.979,"words":[[33.17,33.638,"Era",0.998],[33.908,34.016,"um",0.999],[34.016,35.024,"queijo",0.999],[35.024,36.014,"coalho",0.84],[36.014,36.374,"que",1],[36.554,37.184,"todo",1],[37.184,37.958,"mundo",1],[38.21,39.65,"queria.",0.993]]},
    {"idx":6,"start":46.74,"end":50.52,"text":"Em 72 eu fui servir o exército em Manaus.","confidence":0.995,"words":[[46.74,46.74,"Em",0.999],[46.74,47,"72",0.977],[47.15,47.33,"eu",0.981],[47.33,47.65,"fui",1],[47.65,48.29,"servir",1],[48.3,48.41,"o",1],[48.41,49.28,"exército",0.996],[49.28,49.41,"em",1],[49.54,50.52,"Manaus.",1]]},
    {"idx":7,"start":53.82,"end":56.24,"text":"Eu nunca tinha andado de avião.","confidence":0.998,"words":[[53.82,53.995063829787235,"Eu",0.998],[53.995063829787235,54.43787234042553,"nunca",1],[54.52025531914894,54.88068085106383,"tinha",1],[54.88068085106383,55.34408510638298,"andado",0.991],[55.41617021276596,55.57063829787234,"de",1],[55.57063829787234,56.24,"avião.",0.999]]},
    {"idx":8,"start":59.94,"end":63.06,"text":"O quartel ficava na beira do rio negro.","confidence":0.965,"words":[[59.94,59.94,"O",1],[59.94,60.20337662337662,"quartel",0.998],[60.35532467532468,60.95298701298701,"ficava",1],[60.95298701298701,61.10493506493507,"na",1],[61.31766233766234,61.67220779220779,"beira",1],[61.67220779220779,61.87480519480519,"do",1],[61.87480519480519,62.1787012987013,"rio",0.762],[62.1787012987013,63.06,"negro.",0.957]]},
    {"idx":9,"start":66.26,"end":69.9,"text":"Fazia um calor que eu nunca tinha sentido na vida.","confidence":0.998,"words":[[66.26,66.26,"Fazia",0.999],[66.26,66.41,"um",0.995],[66.41,66.86,"calor",1],[66.93,67.18,"que",1],[67.18,67.37,"eu",1],[67.37,67.85,"nunca",1],[67.85,68.33,"tinha",1],[68.33,68.93,"sentido",0.983],[69.06,69.17,"na",1],[69.24,69.9,"vida.",1]]},
    {"idx":10,"start":73.45,"end":77.33,"text":"Lá eu aprendi a nadar e a consertar motor de barco.","confidence":0.984,"words":[[73.45,73.45,"Lá",1],[73.45,73.45,"eu",1],[73.45,74.02295336787564,"aprendi",0.998],[74.02295336787564,74.05310880829016,"a",1],[74.12347150259068,74.60595854922279,"nadar",1],[74.72658031088083,74.72658031088083,"e",1],[74.81704663212436,74.82709844559585,"a",0.999],[74.82709844559585,75.7418134715026,"consertar",1],[75.7418134715026,76.1237823834197,"motor",0.828],[76.26450777202072,76.45549222797928,"de",1],[76.45549222797928,77.33,"barco.",0.999]]}
